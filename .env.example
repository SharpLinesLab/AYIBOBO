# Server port (the production server serves the built frontend and the /api routes)
PORT=8787
# SQLite database (newsletter subscribers, accounts, sessions, uploads)
DATABASE_FILE=./data/asf.db
# The old JSON datastore. If it exists, its newsletter subscribers are copied into SQLite once.
DATA_FILE=./data/db.json
# Scales every API rate limit (default 1). Only raise it for load or end-to-end testing.
# RATE_LIMIT_MULTIPLIER=1
# Signs sign-in sessions. REQUIRED in production: a random string of at least 32 characters
# (e.g. `openssl rand -base64 48`). The server refuses to start without it.
SESSION_SECRET=
# The site's public address, used in password-reset links. REQUIRED in production.
PUBLIC_URL=http://localhost:8787
# Where uploaded audio and cover images are stored (a persistent volume in production)
UPLOADS_DIR=./data/uploads
