# Server port (the production server serves the built frontend and the /api routes)
PORT=8787
# Public URL used for Stripe success/cancel redirects
PUBLIC_URL=http://localhost:8787
# Stripe. When STRIPE_SECRET_KEY is unset the server runs in simulated-payment mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Allow instant simulated payments when Stripe is not configured (never enable in real production)
ALLOW_SIMULATED_PAYMENTS=true
# Where the JSON datastore lives
DATA_FILE=./data/db.json
# Scales every API rate limit (default 1). Only raise it for load or end-to-end testing.
# RATE_LIMIT_MULTIPLIER=1
# Pre-populate the board with the 20 fictional demo listings on first boot (set false for a real launch)
SEED_DEMO=true
